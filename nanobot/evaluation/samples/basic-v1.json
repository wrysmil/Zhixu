    {
      "id": "B11",
      "name": "B11：不完整任务应先澄清",
      "description": "任务信息不完整，应先提出一个必要问题而不是猜测执行；由必需量表判定。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "把报告转换成正确的格式再发给我。"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file"]},
      "script": [
        {"text": "请问您指的是哪份报告、希望转换成什么格式？我需要确认输入文件和目标格式后再执行。"}
      ],
      "assertions": [
        {"id": "asks-question", "kind": "answer_contains", "text": "？", "required": false}
      ],
      "rubric": {
        "version": "general-v1",
        "required": true,
        "dimensions": [
          {
            "id": "task_completion",
            "name": "任务完成度",
            "anchors": [
              "0：完全没有执行任务，或回答与任务无关。",
              "1：只做了少量相关工作，任务主体未完成。",
              "2：完成了任务的一部分，但缺少关键步骤或关键输出。",
              "3：完整完成任务的必要步骤，输出满足任务要求。",
              "4：完整且超出预期地完成任务，输出干净利落无冗余。"
            ],
            "pass_score": 3
          },
          {
            "id": "correctness",
            "name": "正确性",
            "anchors": [
              "0：结果错误且具有误导性，或凭空编造内容。",
              "1：结果存在明显错误，只有少量正确信息。",
              "2：结果大体相关但包含错误或与证据不符之处。",
              "3：结果正确，与任务给定的证据一致，无虚构。",
              "4：结果完全正确，细节精确且可验证。"
            ],
            "pass_score": 3
          }
        ]
      }
    },
