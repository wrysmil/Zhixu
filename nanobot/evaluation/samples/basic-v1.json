{
  "schema_version": 1,
  "suite": {
    "name": "基础用例集 v1",
    "description": "随包发布的 20 条离线基础用例（B01–B20）：覆盖契约 §2 的全部 10 种断言与 fixture 模式的全部受控能力，导入后可直接运行。",
    "tags": ["builtin", "basic-v1", "offline"]
  },
  "cases": [
    {
      "id": "B01",
      "name": "B01：直接回答 2+3",
      "description": "简短数学题：只输出结果数字 5。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "请计算 2+3，只输出结果数字，不要任何其他文字。"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file"]},
      "script": [
        {"text": "5"}
      ],
      "assertions": [
        {"id": "answer-is-5", "kind": "answer_contains", "text": "5", "required": true},
        {"id": "answer-no-8", "kind": "answer_not_contains", "text": "8", "required": true}
      ]
    },
    {
      "id": "B02",
      "name": "B02：输出约定 JSON",
      "description": "按约定输出 {\"status\":\"ok\",\"count\":3}。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "输出一个 JSON 对象：status 为 ok、count 为 3。只输出 JSON，不要其他内容。"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file"]},
      "script": [
        {"json_text": "{\"status\": \"ok\", \"count\": 3}"}
      ],
      "assertions": [
        {
          "id": "answer-count-3",
          "kind": "answer_json",
          "schema": {
            "type": "object",
            "properties": {
              "status": {"type": "string"},
              "count": {"type": "integer"}
            },
            "required": ["status", "count"],
            "additionalProperties": false
          },
          "checks": [{"pointer": "/count", "equals": 3}],
          "required": true
        }
      ]
    },
    {
      "id": "B03",
      "name": "B03：读取文件并复述标识",
      "description": "读取 input.txt，复述其中的英文标识 alpha。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "读取 input.txt，并复述文件中的英文标识。"}
      ],
      "fixtures": [
        {"path": "input.txt", "content": "alpha\nbeta\n", "encoding": "utf-8"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file"]},
      "script": [
        {"tool_calls": [{"name": "read_file", "arguments": {"path": "input.txt"}}]},
        {"text": "文件中的英文标识是 alpha。"}
      ],
      "assertions": [
        {
          "id": "read-called",
          "kind": "tool_called",
          "name": "read_file",
          "arguments_subset": {"path": "input.txt"},
          "min_calls": 1,
          "required": true
        },
        {"id": "answer-alpha", "kind": "answer_contains", "text": "alpha", "required": true}
      ]
    },
    {
      "id": "B04",
      "name": "B04：创建 output.txt",
      "description": "在工作区创建 output.txt，正文写入 hello。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "在工作区创建文件 output.txt，正文写入 hello。"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["write_file"]},
      "script": [
        {"tool_calls": [{"name": "write_file", "arguments": {"path": "output.txt", "content": "hello"}}]},
        {"text": "已创建 output.txt，正文 hello。"}
      ],
      "artifact_paths": ["output.txt"],
      "assertions": [
        {"id": "output-exists", "kind": "file_exists", "path": "output.txt", "required": true},
        {"id": "output-content", "kind": "file_contains", "path": "output.txt", "text": "hello", "required": true}
      ]
    },
    {
      "id": "B05",
      "name": "B05：编辑 JSON 中的 old→new",
      "description": "把 draft.json 中 state 的值从 old 改为 new，其他字段保持不变。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "编辑 draft.json，把 state 的值从 old 改为 new，保持其他字段不变。"}
      ],
      "fixtures": [
        {"path": "draft.json", "content": "{\n  \"state\": \"old\",\n  \"keep\": true\n}\n", "encoding": "utf-8"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file", "edit_file"]},
      "script": [
        {"tool_calls": [{"name": "read_file", "arguments": {"path": "draft.json"}}]},
        {"tool_calls": [{"name": "edit_file", "arguments": {"path": "draft.json", "old_text": "\"old\"", "new_text": "\"new\""}}]},
        {"text": "已把 draft.json 的 state 从 old 改为 new，keep 字段保持 true。"}
      ],
      "artifact_paths": ["draft.json"],
      "assertions": [
        {
          "id": "draft-state",
          "kind": "file_json",
          "path": "draft.json",
          "schema": {
            "type": "object",
            "properties": {
              "state": {"type": "string"},
              "keep": {"type": "boolean"}
            },
            "required": ["state", "keep"],
            "additionalProperties": false
          },
          "checks": [
            {"pointer": "/state", "equals": "new"},
            {"pointer": "/keep", "equals": true}
          ],
          "required": true
        }
      ]
    },
    {
      "id": "B06",
      "name": "B06：列举目录文件",
      "description": "列举 data 目录下的 a.txt 与 b.txt。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "列出 data 目录下的所有文件，并在一句话中说明有哪些文件。"}
      ],
      "fixtures": [
        {"path": "data/a.txt", "content": "alpha\n", "encoding": "utf-8"},
        {"path": "data/b.txt", "content": "beta\n", "encoding": "utf-8"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["list_dir"]},
      "script": [
        {"tool_calls": [{"name": "list_dir", "arguments": {"path": "data"}}]},
        {"text": "data 目录下有 a.txt 和 b.txt 两个文件。"}
      ],
      "assertions": [
        {
          "id": "list-called",
          "kind": "tool_called",
          "name": "list_dir",
          "arguments_subset": {"path": "data"},
          "min_calls": 1,
          "required": true
        },
        {"id": "answer-files", "kind": "answer_contains", "text": "a.txt", "required": true}
      ]
    },
    {
      "id": "B07",
      "name": "B07：求和小票写入 total.json",
      "description": "读取 sales.csv 中的整数求和，把 42 写入 total.json。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "读取 sales.csv 中的整数并按行求和，把结果以 {\"total\": <整数>} 写入 total.json。"}
      ],
      "fixtures": [
        {"path": "sales.csv", "content": "10\n12\n20\n", "encoding": "utf-8"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file", "write_file"]},
      "script": [
        {"tool_calls": [{"name": "read_file", "arguments": {"path": "sales.csv"}}]},
        {"tool_calls": [{"name": "write_file", "arguments": {"path": "total.json", "content": "{\"total\": 42}"}}]},
        {"text": "三笔金额 10、12、20 的和是 42，已写入 total.json。"}
      ],
      "artifact_paths": ["total.json"],
      "assertions": [
        {
          "id": "total-json",
          "kind": "file_json",
          "path": "total.json",
          "schema": {
            "type": "object",
            "properties": {"total": {"type": "integer"}},
            "required": ["total"],
            "additionalProperties": false
          },
          "checks": [{"pointer": "/total", "equals": 42}],
          "required": true
        }
      ]
    },
    {
      "id": "B08",
      "name": "B08：分类计数写 counts.json",
      "description": "统计 items.json 中 a 与 b 两类出现次数，写入 counts.json。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "读取 items.json，统计 a 与 b 两类各出现几次，把计数写入 counts.json（形如 {\"a\": n, \"b\": m}）。"}
      ],
      "fixtures": [
        {"path": "items.json", "content": "{\"items\": [{\"type\": \"a\"}, {\"type\": \"a\"}, {\"type\": \"b\"}]}\n", "encoding": "utf-8"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file", "write_file"]},
      "script": [
        {"tool_calls": [{"name": "read_file", "arguments": {"path": "items.json"}}]},
        {"tool_calls": [{"name": "write_file", "arguments": {"path": "counts.json", "content": "{\"a\": 2, \"b\": 1}"}}]},
        {"text": "a 出现 2 次、b 出现 1 次，已写入 counts.json。"}
      ],
      "artifact_paths": ["counts.json"],
      "assertions": [
        {"id": "counts-exists", "kind": "file_exists", "path": "counts.json", "required": true},
        {
          "id": "counts-json",
          "kind": "file_json",
          "path": "counts.json",
          "schema": {
            "type": "object",
            "properties": {
              "a": {"type": "integer"},
              "b": {"type": "integer"}
            },
            "required": ["a", "b"],
            "additionalProperties": false
          },
          "checks": [
            {"pointer": "/a", "equals": 2},
            {"pointer": "/b", "equals": 1}
          ],
          "required": true
        }
      ]
    },
    {
      "id": "B09",
      "name": "B09：两文件整数合并写 result.json",
      "description": "读取 a.txt 与 b.txt 求和，写入 result.json，全程不超过 3 次工具调用。",
      "suite_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "turns": [
        {"content": "读取 a.txt 与 b.txt 中的整数，求和后写入 result.json（{\"sum\": <整数>}）。"}
      ],
      "fixtures": [
        {"path": "a.txt", "content": "4\n", "encoding": "utf-8"},
        {"path": "b.txt", "content": "5\n", "encoding": "utf-8"}
      ],
      "execution": {"tool_mode": "fixture", "allowed_tools": ["read_file", "write_file"]},
      "script": [
        {"tool_calls": [
          {"name": "read_file", "arguments": {"path": "a.txt"}},
          {"name": "read_file", "arguments": {"path": "b.txt"}}
        ]},
        {"tool_calls": [{"name": "write_file", "arguments": {"path": "result.json", "content": "{\"sum\": 9}"}}]},
        {"text": "4 与 5 的和是 9，已写入 result.json。"}
      ],
      "artifact_paths": ["result.json"],
      "assertions": [
        {
          "id": "reads-both",
          "kind": "tool_called",
          "name": "read_file",
          "min_calls": 2,
          "required": true
        },
        {
          "id": "result-json",
          "kind": "file_json",
          "path": "result.json",
          "schema": {
            "type": "object",
            "properties": {"sum": {"type": "integer"}},
            "required": ["sum"],
            "additionalProperties": false
          },
          "checks": [{"pointer": "/sum", "equals": 9}],
          "required": true
        },
        {"id": "call-budget", "kind": "tool_call_limit", "maximum": 3, "required": true}
      ]
    },
