{
  "schema_version": 1,
  "version": "grader-counterexamples-v2",
  "rubric_ref": "reliability-v2",
  "description": "评分器反例集：每条给出一个明确错误的 Agent/团队输出 fixture 与期望判定。期望判定只能是 disqualified 或 review_required，不允许 qualified。判分由 nanobot/evaluation/graders/rules.py 与 nanobot/evaluation/assessment.py 真实执行，不使用桩判定。",
  "notes": [
    "wrong_output 是刻意做错的输出，case 是该反例对应的判据（含 evaluation 任务判据）。",
    "expected.reason_codes 是断言消息或维度原因的前缀匹配。",
    "expected.failed_assertion_ids 是必须判失败的断言 id；判为 review_required 时为空。"
  ],
  "counterexamples": [
    {
      "counterexample_id": "GE-01",
      "target": "team",
      "scenario": "团队只回一句话却超长堆关键词，并把成员名写进回答就宣称成员都已完成：关键词齐但违反长度约束，且没有真实委派证据。",
      "case": {
        "name": "GE-01 团队超长关键词回答",
        "description": "",
        "tags": [
          "counterexample",
          "reliability-v2"
        ],
        "enabled": true,
        "suite_id": "c1d94a08-7b32-4e6f-a5d9-3f0b28c7e915",
        "turns": [
          {
            "content": "只回一句话说明团队是否完成项目 X，不要展开。"
          }
        ],
        "fixtures": [],
        "memory_seed": [],
        "clock_iso": null,
        "tool_fixtures": [],
        "execution": {
          "tool_mode": "fixture",
          "allowed_tools": [
            "read_file",
            "write_file"
          ],
          "max_iterations": 4,
          "timeout_s": 60
        },
        "assertions": [
          {
            "id": "one-line",
            "kind": "answer_length",
            "required": true,
            "max_chars": 60,
            "min_chars": 0
          },
          {
            "id": "members",
            "kind": "team_member_executed",
            "required": true,
            "member_ids": [
              "researcher",
              "writer"
            ]
          },
          {
            "id": "says-done",
            "kind": "answer_contains",
            "required": true,
            "text": "完成",
            "case_sensitive": true
          }
        ],
        "rubric": null,
        "script": [],
        "artifact_paths": [],
        "evaluation": {
          "version": 2,
          "required_dimensions": [
            "task",
            "constraints",
            "trajectory"
          ],
          "milestones": [
            {
              "id": "m1",
              "weight": 1,
              "assertion_ids": [
                "says-done"
              ]
            }
          ],
          "required_evidence": [
            "final_answer",
            "trace",
            "delegation"
          ]
        }
      },
      "wrong_output": {
        "final_answer": "researcher 已完成，writer 已完成，团队已完成项目 X 的全部工作：需求梳理、方案设计、代码实现、测试验收、上线发布，所有成员都完成了各自的部分，交付质量良好，可以直接进入下一阶段。",
        "tool_calls": [],
        "trace_events": [
          {
            "type": "agent.started",
            "seq": 1,
            "payload": {
              "execution_id": "exec-ge-01",
              "target_kind": "team",
              "target_id": "frozen-team-v2"
            }
          },
          {
            "type": "agent.completed",
            "seq": 2,
            "payload": {}
          }
        ],
        "files": {},
        "artifacts": [],
        "usage": {
          "source": "reported",
          "coverage": "complete",
          "total_tokens": 120,
          "output_tokens": 60
        },
        "duration_ms": 900,
        "trace_sealed": true,
        "trace_complete": true,
        "execution_status": "succeeded"
      },
      "expected": {
        "qualification": "disqualified",
        "task_outcome": "completed",
        "failed_assertion_ids": [
          "one-line",
          "members"
        ],
        "reason_codes": [
          "ANSWER_TOO_LONG",
          "TEAM_MEMBER_NOT_EXECUTED"
        ],
        "note": "任务维度虽然通过（关键词命中），但硬约束与轨迹失败仍然不合格：关键词不能替代约束与委派证据。"
      }
    },
