{
  "$schema": "https://json.schemastore.org/package",
  "name": "zhixu-desktop",
  "productName": "知序",
  "version": "0.1.0",
  "private": true,
  "description": "知序 — desktop shell (Electron) for the Agent-With-Memory WebUI. Page style referenced from Hope Agent.",
  "author": "Agent-With-Memory",
  "main": "main.cjs",
  "scripts": {
    "start": "node scripts/run.cjs start",
    "dev": "node scripts/run.cjs dev",
    "smoke": "node scripts/run.cjs smoke",
    "test:browser-policy": "node --test browser-policy.test.cjs",
    "dist": "electron-builder --win nsis",
    "dist:all": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.zhixu.desktop",
    "productName": "知序",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "browser-policy.cjs",
      "boot.html",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "知序-Setup-${version}.${ext}"
    }
  }
}
