# Copy to .env and fill every CHANGEME value before `docker compose up -d`.
# Generate random values with: openssl rand -hex 16 (passwords/secrets)
#                               openssl rand -hex 32 (ENCRYPTION_KEY)

POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME

REDIS_AUTH=CHANGEME

MINIO_ROOT_USER=langfuseminio
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse

SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

# First-boot initialization: creates org/project/API keys/admin user automatically.
LANGFUSE_INIT_ORG_ID=zhixu-local
LANGFUSE_INIT_ORG_NAME=Zhixu Local
LANGFUSE_INIT_PROJECT_ID=zhixu
LANGFUSE_INIT_PROJECT_NAME=zhixu
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@zhixu.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
