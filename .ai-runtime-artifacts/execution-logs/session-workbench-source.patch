diff --git a/webui/src/components/workbench/session-workbench-api.ts b/webui/src/components/workbench/session-workbench-api.ts
new file mode 100644
index 0000000..c6e7b41
--- /dev/null
+++ b/webui/src/components/workbench/session-workbench-api.ts
@@ -0,0 +1,59 @@
+import { request } from "@/lib/api";
+
+export type WorkbenchTaskStatus = "pending" | "in_progress" | "completed" | "blocked" | "cancelled";
+export interface WorkbenchTask {
+  id: string;
+  title: string;
+  status: WorkbenchTaskStatus;
+  source: string;
+  detail?: string;
+}
+export interface SessionWorkbenchSnapshot {
+  schema_version: 1;
+  session_key: string;
+  updated_at: string | null;
+  goal: { objective: string; status: string; ui_summary?: string; recap?: string } | null;
+  tasks: WorkbenchTask[];
+  plan: { explanation: string; steps: WorkbenchTask[]; updated_at: string | null } | null;
+  agents: { id: string; name: string; status: string; detail: string; invocation_id: string }[];
+  memories: { id: string; kind: "working" | "long_term"; title: string; content: string; source: string; updated_at: string | null; persisted: boolean }[];
+  skills: { name: string; status: "available" | "always_loaded" | "used"; source: string }[];
+  mcp: { name: string; status: string; calls: number; successes: number | null; failures: number | null }[];
+  limitations: string[];
+}
+
+type Row = Record<string, unknown>;
+const record = (value: unknown): value is Row => !!value && typeof value === "object" && !Array.isArray(value);
+const string = (value: unknown): value is string => typeof value === "string";
+const nullableString = (value: unknown) => value === null || string(value);
+const count = (value: unknown) => typeof value === "number" && Number.isInteger(value) && value >= 0;
+const nullableCount = (value: unknown) => value === null || count(value);
+const rows = (value: unknown, validate: (row: Row) => boolean) => Array.isArray(value) && value.every((row: unknown) => record(row) && validate(row));
+const task = (row: Row) => [row.id, row.title, row.source].every(string)
+  && string(row.status) && ["pending", "in_progress", "completed", "blocked", "cancelled"].includes(row.status)
+  && (row.detail === undefined || string(row.detail));
+
+function validSnapshot(data: unknown, sessionKey: string): data is SessionWorkbenchSnapshot {
+  return record(data) && data.schema_version === 1 && data.session_key === sessionKey && nullableString(data.updated_at)
+    && (data.goal === null || (record(data.goal) && string(data.goal.objective) && string(data.goal.status)
+      && [data.goal.ui_summary, data.goal.recap].every((value) => value === undefined || string(value))))
+    && rows(data.tasks, task)
+    && (data.plan === null || (record(data.plan) && string(data.plan.explanation) && rows(data.plan.steps, task) && nullableString(data.plan.updated_at)))
+    && rows(data.agents, (row) => [row.id, row.name, row.status, row.detail, row.invocation_id].every(string))
+    && rows(data.memories, (row) => [row.id, row.title, row.content, row.source].every(string)
+      && (row.kind === "working" || row.kind === "long_term") && typeof row.persisted === "boolean" && nullableString(row.updated_at))
+    && rows(data.skills, (row) => string(row.name) && string(row.source) && string(row.status) && ["available", "always_loaded", "used"].includes(row.status))
+    && rows(data.mcp, (row) => string(row.name) && string(row.status) && count(row.calls) && nullableCount(row.successes) && nullableCount(row.failures))
+    && Array.isArray(data.limitations) && data.limitations.every(string);
+}
+
+export async function fetchSessionWorkbench(token: string, sessionKey: string, signal: AbortSignal): Promise<SessionWorkbenchSnapshot> {
+  const data = await request<unknown>(
+    `/api/sessions/${encodeURIComponent(sessionKey)}/workbench`, token,
+    { signal, cache: "no-store" }, 15_000,
+  );
+  if (!validSnapshot(data, sessionKey)) {
+    throw new Error("工作台返回的数据格式不正确");
+  }
+  return data;
+}
diff --git a/webui/src/components/workbench/use-session-workbench.ts b/webui/src/components/workbench/use-session-workbench.ts
new file mode 100644
index 0000000..00c5cec
--- /dev/null
+++ b/webui/src/components/workbench/use-session-workbench.ts
@@ -0,0 +1,83 @@
+import { useEffect, useRef, useState } from "react";
+import type { ZhixuClient } from "@/lib/zhixu-client";
+import { fetchSessionWorkbench, type SessionWorkbenchSnapshot } from "./session-workbench-api";
+
+export type WorkbenchEventClient = Pick<ZhixuClient, "onChat" | "onSessionUpdate" | "onStatus" | "status">;
+interface Options { sessionKey?: string | null; token?: string; client?: WorkbenchEventClient; }
+interface State { identity: string; snapshot: SessionWorkbenchSnapshot | null; loading: boolean; error: string | null; }
+
+export function useSessionWorkbench({ sessionKey, token, client }: Options) {
+  const identity = JSON.stringify([sessionKey, token]);
+  const [state, setState] = useState<State>({ identity, snapshot: null, loading: false, error: null });
+  const refreshRef = useRef<() => void>(() => {});
+
+  // Cleanup cancels requests, subscriptions and timers, including Strict Mode remounts.
+  // https://react.dev/reference/react/useEffect#fetching-data-with-effects
+  useEffect(() => {
+    let disposed = false;
+    let request: AbortController | null = null;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let dirty = false;
+    const chatId = sessionKey?.replace(/^websocket:/, "");
+    const canFetch = () => !!sessionKey && !!token && !document.hidden && (!client || client.status === "open");
+    setState({ identity, snapshot: null, loading: !!sessionKey && !!token, error: null });
+
+    const load = async () => {
+      if (disposed || !canFetch()) return;
+      if (request) { dirty = true; return; }
+      if (timer) clearTimeout(timer);
+      const controller = new AbortController();
+      request = controller;
+      setState((current) => ({ ...current, loading: !current.snapshot, error: null }));
+      let active = false;
+      try {
+        const snapshot = await fetchSessionWorkbench(token!, sessionKey!, controller.signal);
+        if (disposed || controller.signal.aborted) return;
+        active = snapshot.tasks.some((task) => task.status === "in_progress")
+          || snapshot.agents.some((agent) => ["running", "pending", "queued"].includes(agent.status));
+        setState({ identity, snapshot, loading: false, error: null });
+      } catch (reason) {
+        if (disposed || controller.signal.aborted) return;
+        setState((current) => ({ ...current, loading: false, error: reason instanceof Error ? reason.message : "无法读取工作台" }));
+      } finally {
+        request = null;
+        if (!disposed && canFetch()) {
+          if (dirty) { dirty = false; timer = setTimeout(() => void load(), 350); }
+          else timer = setTimeout(() => void load(), active ? 10_000 : 30_000);
+        }
+      }
+    };
+    const refresh = () => {
+      if (timer) clearTimeout(timer);
+      timer = setTimeout(() => void load(), 200);
+    };
+    refreshRef.current = refresh;
+    const onVisibility = () => {
+      if (document.hidden) { if (timer) clearTimeout(timer); }
+      else refresh();
+    };
+    document.addEventListener("visibilitychange", onVisibility);
+    const unsubChat = chatId ? client?.onChat(chatId, (event) => {
+      if (!["delta", "reasoning_delta"].includes(event.event)) refresh();
+    }) : undefined;
+    const unsubSession = client?.onSessionUpdate((id) => {
+      if (id === chatId || id === sessionKey) refresh();
+    });
+    const unsubStatus = client?.onStatus((status) => {
+      if (status === "open") refresh();
+      else if (timer) clearTimeout(timer);
+    });
+    void load();
+    return () => {
+      disposed = true;
+      request?.abort();
+      if (timer) clearTimeout(timer);
+      document.removeEventListener("visibilitychange", onVisibility);
+      unsubChat?.(); unsubSession?.(); unsubStatus?.();
+      refreshRef.current = () => {};
+    };
+  }, [identity, sessionKey, token, client]);
+
+  const visible = state.identity === identity ? state : { snapshot: null, loading: !!sessionKey && !!token, error: null };
+  return { ...visible, refresh: () => refreshRef.current() };
+}
